# ───────────────────────────── SoundSense environment ─────────────────────────────
# Copy to .env.local for local work. In production set these in your host's dashboard
# (Vercel / Render → Environment Variables). NEVER commit real values.

# ── Database ──────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase: Project Settings → Database → Connection string,
# use the *pooler* URI on Vercel). If this is EMPTY the app uses an embedded Postgres
# (PGlite, stored in .data/pglite) so you can run it locally with zero setup.
DATABASE_URL=
# Set to "false" only for a local Postgres without TLS.
DATABASE_SSL=true
# Run pending migrations automatically at boot (always on for the embedded DB).
AUTO_MIGRATE=false

# ── Sessions & security ───────────────────────────────────────────────────────────
# 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public base URL – used in e-mail links and for the Origin check.
APP_URL=http://localhost:3000
# Require e-mail verification before login (recommended: true in production).
REQUIRE_EMAIL_VERIFICATION=true

# ── First administrator (created by `npm run db:seed`) ─────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Now-123!
# Seed demo customer + consultant accounts (development only!)
SEED_DEMO=false

# ── E-mail (verification, password reset, booking notices) ─────────────────────────
# Leave SMTP_HOST empty to print e-mails to the server console (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SoundSense <no-reply@example.com>"

# ── AI chatbot (server-side only – never exposed to the browser) ───────────────────
# Without a key the chatbot runs in a rule-based "offline guidance" mode and says so.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Optional tuning ───────────────────────────────────────────────────────────────
# bcrypt work factor (12 ≈ 250 ms on a modern CPU). Raise over time; never go below 10.
BCRYPT_COST=12
# Max connections in the pg pool (keep small on serverless + pooler).
DATABASE_POOL_MAX=5
# Where the embedded PGlite database lives when DATABASE_URL is empty (local development only).
PGLITE_DIR=.data/pglite
